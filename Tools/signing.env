# 1Password secret references for signing local release builds. Not secrets themselves: `op run`
# swaps each op:// reference for the real value only while Tools/release-local.sh runs Gradle.
# Point them at your own vault/item if yours differ.
BYEDIRTY_KEYSTORE_PASSWORD=op://Private/byedirty-release-key/password
BYEDIRTY_KEY_PASSWORD=op://Private/byedirty-release-key/password
BYEDIRTY_KEY_ALIAS=byedirty
