# 1Password secret references for signing local release builds. Not secrets themselves: `op run`
# swaps each op:// reference for the real value only while Tools/release-local.sh runs Gradle.
# The vault comes from BYEDIRTY_OP_VAULT (default "Personal"); the item is "byedirty-release-key".
BYEDIRTY_KEYSTORE_PASSWORD=op://${BYEDIRTY_OP_VAULT}/byedirty-release-key/password
BYEDIRTY_KEY_PASSWORD=op://${BYEDIRTY_OP_VAULT}/byedirty-release-key/password
BYEDIRTY_KEY_ALIAS=byedirty
